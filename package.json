{
  "name": "next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build --turbopack",
    "start": "next start",
    "lint": "eslint . --cache --cache-location .eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location .eslintcache",
    "format": "prettier --write .",
    "postinstall": "prisma db push && prisma generate",
    "docker:build": "docker build -t language-exercise .",
    "docker:prod": "docker-compose -f docker-compose.production.yml up -d",
    "docker:prod:down": "docker-compose -f docker-compose.production.yml down",
    "docker:prod:logs": "docker-compose -f docker-compose.production.yml logs -f"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@google/generative-ai": "^0.24.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.4",
    "@mui/material-nextjs": "^7.3.3",
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "joi": "^17.9.2",
    "jose": "^5.9.6",
    "next": "15.5.4",
    "next-auth": "^4.24.12",
    "nodemailer": "^8.0.5",
    "openai": "^6.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.64.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "20.6.0",
    "@types/nodemailer": "^7.0.3",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-refresh": "^0.4.23",
    "prisma": "6.19.3",
    "standard-version": "^9.5.0",
    "typescript": "5.9.2"
  }
}
