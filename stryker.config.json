{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "incremental": false,
  "cleanTempDir": "always",
  "mutate": [
    "src/utils/exerciseContent.ts",
    "src/utils/omitUndefined.ts",
    "src/utils/languageRedirect.ts",
    "src/utils/crypto.ts",
    "src/services/translateService.ts",
    "src/services/checkAnswersService.ts",
    "src/services/generateTextService.ts",
    "src/utils/aiResponse.ts",
    "src/store/exerciseBlocks.ts",
    "src/services/openAI.ts",
    "src/services/checkEssayService.ts",
    "src/services/trainingExercisesService.ts",
    "src/utils/feedbackValidation.ts",
    "src/utils/auth.ts",
    "src/utils/jsonWrapper.ts",
    "src/utils/NextResponseError.ts",
    "src/utils/tokenService.ts",
    "src/constants/aiModels.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/generated/**"
  ],
  "thresholds": {
    "high": 90,
    "low": 89,
    "break": 89
  },
  "timeoutMS": 20000
}
