// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tag {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  name           String   @unique
  createdAt      DateTime @default(now())
  color          String?
  backgroudColor String?
  borderColor    String?
  ownerId        String?  @db.ObjectId

  // NOTE: Relation to words through many-to-many
  owner     User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  EntityTag EntityTag[]

  @@map("tags")
}

model Word {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  word      String
  translate String
  createdAt DateTime @default(now())
  ownerId   String?  @db.ObjectId
  shared    Boolean  @default(false)

  // NOTE: Many-to-many relation with tags

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("dictionary_words")
}

model EntityTag {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  entityType String
  entityId   String
  tagId      String @db.ObjectId

  tag Tag @relation(fields: [tagId], references: [id])

  @@map("word_tags")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  tag             Tag[]
  word            Word[]
  tokens          UserToken[]
  settings        UserSettings?
  sentenceHistory SentenceHistory[]

  @@map("users")
}

model UserToken {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  service        String // 'gemini', 'deepl', 'auth', etc.
  encryptedToken String // encrypted token value
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, service])
  @@map("user_tokens")
}

model UserSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  theme           String?  @default("light") // 'light', 'dark'
  aiModel         String?  @default("gemini-2.5-flash") // selected AI model
  language        String?  @default("en") // interface language
  translationLang String?  @default("RU") // target translation language
  customSettings  Json? // for additional flexible settings storage
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Language {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  code      String   @unique // e.g., "en", "pl"
  name      String   // e.g., "English", "Polish"
  nativeName String  // e.g., "English", "Polski"
  createdAt DateTime @default(now())

  @@map("languages")
}

model SentenceHistory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sentence    String
  language    String
  usedWordIds String[] @db.ObjectId
  level       String
  ownerId     String   @db.ObjectId
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Связь с Word (неявная, через usedWordIds)
  // Можно добавить ownerId, если нужна привязка к пользователю
  @@map("sentence_history")
}
