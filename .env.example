# Database Configuration
# MongoDB connection string - For production, use MongoDB Atlas or self-hosted MongoDB with replica set
# Local development: mongodb://localhost:27017/exercises?directConnection=true
# Production: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/exercises?directConnection=true"

# JWT Authentication
# Secret key for JWT token signing - MUST be changed in production to a strong random string
JWT_SECRET="your-secret-key-change-this-in-production"
# Cookie name for storing JWT token
JWT_COOKIE_NAME="app_token"
# JWT token expiration time (e.g., 7d, 24h, 30m)
JWT_EXPIRES_IN="7d"

# Encryption
# Secret key for encrypting user API tokens - MUST be changed in production
# Must be exactly 32 characters long (use the generation command below)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
TOKEN_SECRET="your-token-secret-change-this-in-production"

# Email Configuration (for password reset)
# SMTP server host (e.g., smtp.gmail.com, smtp-mail.outlook.com, smtp.mailtrap.io for testing)
EMAIL_HOST="smtp.gmail.com"
# SMTP server port (587 for TLS, 465 for SSL)
EMAIL_PORT="587"
# Email account username
EMAIL_USER="your-email@gmail.com"
# Email account password or app-specific password
EMAIL_PASSWORD="your-email-password"
# Email address to send from (should match EMAIL_USER)
EMAIL_FROM="your-email@gmail.com"
# Application URL for email links (e.g., https://yourdomain.com or http://localhost:3000)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Translate API (Optional)
# API key for Google Translate service - Used as fallback translation service
REACT_APP_GOOGLE_TRANSLATE_API_KEY="your-google-translate-api-key"

# Next.js Configuration
# Set to production for deployment
NODE_ENV="production"

# Optional: AI Provider API Keys (Users can add their own keys via the UI)
# These are stored encrypted in the database per user
# If you want to provide default/shared keys, you would handle this in the application logic

# GitHub Integration (for feedback/issue creation)
# Personal Access Token with 'repo' scope - Required for creating issues
# Generate at: https://github.com/settings/tokens/new
GITHUB_TOKEN="your-github-personal-access-token"
# Repository owner (username or organization)
GITHUB_OWNER="Goroshik"
# Repository name
GITHUB_REPO="language_exercise"
